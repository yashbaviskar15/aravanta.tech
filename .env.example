# ARAVANTA TECH - Environment Configuration Example

# Domain Configuration
NEXT_PUBLIC_SITE_URL=https://aravantatech.com

# Contact Form & Dispatcher Configuration
# (When configuring an external email delivery provider like Resend, SendGrid, or custom SMTP)
CONTACT_NOTIFICATION_EMAIL=leads@aravantatech.com
SMTP_HOST=smtp.mailprovider.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Optional Analytics (Privacy-conscious, e.g. Plausible or PostHog)
# NEXT_PUBLIC_ANALYTICS_ID=
